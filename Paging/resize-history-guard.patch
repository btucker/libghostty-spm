+    var source: std.Io.Reader = .fixed(encoded.written());
+    var decoder: Decoder = .init(&source);
+    var decoded = try decoder.ready(testing.allocator, testing.io, test_decode_options);
+    defer decoded.deinit(testing.allocator);
+    var restored = decoded.toOwned();
+    defer restored.deinit(testing.allocator);
+
+    try restored.resize(testing.allocator, .{ .cols = 2, .rows = 4 });
+    try restored.resize(testing.allocator, .{ .cols = 2, .rows = 4 });
+    for (0..2) |_| {
+        const progress = (try decoder.nextAtOriginalWidth(testing.allocator, &restored)).?;
+        try testing.expectEqual(2, progress.page.rows);
+    }
+    // All pages are applied but FINISH is not read yet. A width change must
+    // not invent a recovery requirement for already complete history.
+    try restored.resize(testing.allocator, .{ .cols = 3, .rows = 4 });
+    try testing.expect(try decoder.nextAtOriginalWidth(testing.allocator, &restored) == null);
+    try testing.expect(try decoder.nextAtOriginalWidth(testing.allocator, &restored) == null);
+}
